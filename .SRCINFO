pkgbase = voxtype-crmne-git
	pkgdesc = Push-to-talk voice-to-text for Linux (crmne integration branch, host-adaptive build)
	pkgver = 1.1.1.r1365.g982f19b
	pkgrel = 1
	url = https://github.com/crmne/voxtype
	install = voxtype-crmne-git.install
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = clang
	makedepends = cmake
	makedepends = git
	makedepends = pkgconf
	makedepends = shaderc
	makedepends = vulkan-headers
	makedepends = vulkan-icd-loader
	makedepends = gtk4
	makedepends = gtk4-layer-shell
	makedepends = wayland
	makedepends = libxkbcommon
	depends = alsa-lib
	depends = bash
	depends = curl
	depends = glibc
	depends = gcc-libs
	optdepends = cuda: ONNX engines on NVIDIA GPUs (CUDA 13; only if built with CUDA)
	optdepends = cudnn: ONNX engines on NVIDIA GPUs (only if built with CUDA)
	optdepends = onnxruntime-rocm: ONNX engines on AMD GPUs via MIGraphX (only if built with MIGraphX)
	optdepends = migraphx: ONNX engines on AMD GPUs (only if built with MIGraphX)
	optdepends = rocm-hip-runtime: ONNX engines on AMD GPUs (only if built with MIGraphX)
	optdepends = vulkan-icd-loader: Whisper on the GPU and native OSD rendering
	optdepends = wtype: keyboard simulation for Wayland (recommended, best CJK support)
	optdepends = dotool: keyboard simulation with layout support (KDE/GNOME compatible)
	optdepends = ydotool: keyboard simulation fallback (X11/TTY support)
	optdepends = wl-clipboard: Wayland clipboard support
	optdepends = libnotify: desktop notifications
	optdepends = gtk4: GTK4 OSD frontend
	optdepends = gtk4-layer-shell: GTK4 OSD frontend
	optdepends = wayland: native OSD frontend
	optdepends = libxkbcommon: native OSD frontend
	optdepends = quickshell: Quickshell OSD frontend
	optdepends = qt6-declarative: Quickshell OSD frontend
	provides = voxtype=1.1.1
	conflicts = voxtype
	conflicts = voxtype-bin
	conflicts = voxtype-git
	options = !lto
	options = !debug
	backup = etc/voxtype/config.toml
	source = voxtype::git+https://github.com/crmne/voxtype.git#branch=integration
	source = onnxruntime-cpu-1.24.4.tgz::https://github.com/microsoft/onnxruntime/releases/download/v1.24.4/onnxruntime-linux-x64-1.24.4.tgz
	source = voxtype-crmne-git.install
	source = onnxruntime-cuda13-1.24.4.tgz::https://github.com/microsoft/onnxruntime/releases/download/v1.24.4/onnxruntime-linux-x64-gpu_cuda13-1.24.4.tgz
	sha256sums = SKIP
